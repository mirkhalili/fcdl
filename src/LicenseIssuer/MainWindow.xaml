<Window x:Class="JacquardLicenseIssuer.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="صدور لایسنس ژاکارد — فقط مدیر" Width="780" Height="690" MinWidth="600" MinHeight="500" FlowDirection="RightToLeft" WindowStartupLocation="CenterScreen" Background="#19222E" Foreground="#F4F7F8" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBox"><Setter Property="Background" Value="#273543"/><Setter Property="Foreground" Value="#F4F7F8"/><Setter Property="CaretBrush" Value="#F1AC52"/><Setter Property="BorderBrush" Value="#435363"/><Setter Property="Padding" Value="8"/></Style>
  <Style TargetType="Button"><Setter Property="Background" Value="#EBAE60"/><Setter Property="Foreground" Value="#1C2936"/><Setter Property="BorderBrush" Value="#EBAE60"/><Setter Property="Padding" Value="14,8"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/></Style>
 </Window.Resources>
 <ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel Margin="24">
  <TextBlock FontSize="21" FontWeight="Bold" Text="صدور دستی لایسنس"/>
  <TextBlock Margin="0,12" TextWrapping="Wrap" Text="این ابزار فقط برای مدیر است. کلید خصوصی را محرمانه و خارج از سایت عمومی نگه دارید. رشته صادرشده حداکثر هفت روز اعتبار دارد؛ تمدید و لغو از راه دور به سامانه سایت نیاز دارد."/>
  <Button Content="ساخت جفت‌کلید جدید" Click="GenerateKey" Padding="12,6" HorizontalAlignment="Right"/>
  <TextBlock Margin="0,16,0,4" Text="فایل کلید خصوصی PEM"/><DockPanel><Button DockPanel.Dock="Left" Content="انتخاب فایل" Click="BrowseKey"/><TextBox x:Name="KeyPath" FlowDirection="LeftToRight" IsReadOnly="True"/></DockPanel>
  <TextBlock Margin="0,16,0,4" Text="شناسه دستگاه (۶۴ نویسه)"/><TextBox x:Name="Device" MaxLength="64" FlowDirection="LeftToRight"/>
  <TextBlock Margin="0,16,0,4" Text="شناسه لایسنس (GUID؛ برای تمدید همان شناسه قبلی را وارد کنید)"/><DockPanel><Button DockPanel.Dock="Left" Content="شناسه جدید" Click="NewId"/><TextBox x:Name="LicenseId" FlowDirection="LeftToRight"/></DockPanel>
  <TextBlock Margin="0,16,0,4" Text="اعتبار (روز، حداکثر ۷)"/><TextBox x:Name="Days" Text="7" FlowDirection="LeftToRight"/>
  <Button Content="تولید رشته فعال‌سازی" Click="Issue" Margin="0,16" Padding="12,6" HorizontalAlignment="Right"/>
  <TextBlock Text="رشته فعال‌سازی"/><TextBox x:Name="Token" AcceptsReturn="True" Height="120" TextWrapping="Wrap" FlowDirection="LeftToRight" IsReadOnly="True" VerticalScrollBarVisibility="Auto"/>
  <TextBlock x:Name="Status" Margin="0,12" TextWrapping="Wrap"/>
 </StackPanel></ScrollViewer>
</Window>
