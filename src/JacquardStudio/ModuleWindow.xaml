<Window x:Class="JacquardStudio.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jacquard Studio · Workspace" Width="1500" Height="900" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" WindowState="Maximized" PreviewKeyDown="Workspace_KeyDown" Background="{DynamicResource GraphBackground}" Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}" Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="GraphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="{DynamicResource ButtonBackground}"/><Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/><Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/><Setter Property="Padding" Value="10,7"/><Setter Property="Margin" Value="3,0"/></Style>
    </Window.Resources>
    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/><RowDefinition Height="29"/></Grid.RowDefinitions>
        <Border Background="{DynamicResource GraphHeader}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="29" Height="29" Background="#EA8D3E" CornerRadius="5"><TextBlock Text="▦" FontSize="21" FontWeight="Bold" Foreground="#21160D" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="JACQUARD STUDIO" FontWeight="Bold" FontSize="13"/><TextBlock Text="NODE EDITOR  /  فضای ماژولی" FontSize="9" Foreground="{DynamicResource Muted}"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GraphButton}" Content="پروژه جدید" Click="New_Click"/><Button Style="{StaticResource GraphButton}" Content="باز کردن" Click="Open_Click"/><Button Style="{StaticResource GraphButton}" Content="ذخیره" Click="Save_Click"/><Button Style="{StaticResource GraphButton}" Content="ذخیره با نام" Click="SaveAs_Click"/><Button Style="{StaticResource GraphButton}" Content="تنظیمات" Click="Settings_Click"/><Button Style="{StaticResource GraphButton}" Content="درباره" Click="About_Click"/><Button x:Name="ThemeToggle" Style="{StaticResource GraphButton}" Content="☼" Click="Theme_Click" ToolTip="تغییر تم روشن / تیره" AutomationProperties.Name="تغییر تم روشن یا تیره" FontSize="17"/><Button Style="{StaticResource GraphButton}" Background="#246D5B" BorderBrush="#398770" Foreground="White" Content="▶  اجرای ماژول" Click="Run_Click"/></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition x:Name="LibraryColumn" Width="270"/></Grid.ColumnDefinitions>
            <Border x:Name="LibraryPanel" Grid.Column="1" Background="{DynamicResource GraphSurface}" BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0"><DockPanel Margin="12,15" FlowDirection="RightToLeft"><StackPanel DockPanel.Dock="Top"><TextBlock Text="افزودن ماژول" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="بکشید روی صفحه یا کلیک کنید" TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,12"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ModuleLibrary"/></ScrollViewer></DockPanel></Border>
            <Grid Grid.Column="0" Background="{DynamicResource GraphBackground}"><Grid.RowDefinitions><RowDefinition Height="43"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="{DynamicResource GraphHeader}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1"><Grid Margin="12,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GraphButton}" Content="☰" Click="LibraryToggle_Click" Padding="8,4" ToolTip="باز یا بستن کتابخانه"/><Button Style="{StaticResource GraphButton}" Content="همه در پنجره" Click="FitAll_Click" Padding="8,4"/><TextBlock Text="NODE EDITOR" FontWeight="SemiBold" FontSize="11" Margin="0,0,8,0"/><Button Style="{StaticResource GraphButton}" Content="چیدمان" Click="Arrange_Click" Padding="8,4" ToolTip="چیدمان ماژول‌ها در ردیف و ستون"/><Button Style="{StaticResource GraphButton}" Content="زنجیره عمومی" Click="Preset_Click" Padding="8,4"/><Button Style="{StaticResource GraphButton}" Content="حذف همه" Click="ClearAll_Click" Padding="8,4"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource GraphButton}" Content="−" Click="ZoomOut_Click" Padding="9,3"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="50" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource Muted}"/><Button Style="{StaticResource GraphButton}" Content="+" Click="ZoomIn_Click" Padding="9,3"/><Button Style="{StaticResource GraphButton}" Content="حذف" Click="Delete_Click" Padding="10,3"/></StackPanel></Grid></Border>
                <ScrollViewer x:Name="GraphScroll" PreviewMouseDown="GraphScroll_MouseDown" PreviewMouseMove="GraphScroll_MouseMove" PreviewMouseUp="GraphScroll_MouseUp" LostMouseCapture="GraphScroll_LostMouseCapture" PreviewMouseWheel="GraphScroll_MouseWheel" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="{DynamicResource GraphBackground}"><Canvas x:Name="GraphCanvas" Width="2600" Height="1700" FlowDirection="LeftToRight" AllowDrop="True" DragOver="GraphCanvas_DragOver" Drop="GraphCanvas_Drop"><Canvas.Background><DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute" Viewbox="0,0,14,14" ViewboxUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="{DynamicResource GraphBackground}" Geometry="M0,0 H14 V14 H0 Z"/><GeometryDrawing Brush="{DynamicResource GraphGrid}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,14,1"/><RectangleGeometry Rect="0,0,1,14"/></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Canvas.Background><Canvas x:Name="WireLayer" Width="2600" Height="1700"/><Canvas x:Name="NodeLayer" Width="2600" Height="1700"/></Canvas></ScrollViewer>
            </Grid>
            <ContentControl x:Name="InspectorHost" Visibility="Collapsed"><StackPanel x:Name="Inspector"/></ContentControl>
        </Grid>
        <Border Grid.Row="2" Background="{DynamicResource GraphHeader}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="12,0"><TextBlock x:Name="Status" Text="برای شروع ماژول بارگذاری را باز کنید." VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/><TextBlock Text="JACQUARD  /  NODE EDITOR" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="10"/></Grid></Border>
    </Grid>
</Window>
