<Window x:Class="JacquardStudio.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jacquard Studio · Workspace" Width="1500" Height="900" MinWidth="1080" MinHeight="680" WindowStartupLocation="CenterScreen" Background="#0D131D" Foreground="#EAF2FA" FontFamily="{StaticResource VazirFont}" Closing="Window_Closing">
    <Window.Resources>
        <SolidColorBrush x:Key="GraphMuted" Color="#8FA2B6"/>
        <Style x:Key="GraphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}"><Setter Property="Background" Value="#202D3C"/><Setter Property="BorderBrush" Value="#33475A"/><Setter Property="Foreground" Value="#E8F2F9"/><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="3"/></Style>
    </Window.Resources>
    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions><RowDefinition Height="68"/><RowDefinition Height="*"/><RowDefinition Height="32"/></Grid.RowDefinitions>
        <Border Background="#121D2A" BorderBrush="#273A4C" BorderThickness="0,0,0,1"><Grid Margin="22,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" Background="#35D4B0" CornerRadius="11"><TextBlock Text="▦" FontSize="25" FontWeight="Bold" Foreground="#0B2524" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Margin="12,0,0,0"><TextBlock Text="JACQUARD STUDIO" FontWeight="Bold" FontSize="15" Foreground="#F2F8FC"/><TextBlock Text="NODE WORKSPACE  /  فضای ماژولی" FontSize="10" Foreground="#8EA6B9"/></StackPanel></StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Style="{StaticResource GraphButton}" Content="پروژه جدید" Click="New_Click"/><Button Style="{StaticResource GraphButton}" Content="باز کردن" Click="Open_Click"/><Button Style="{StaticResource GraphButton}" Content="ذخیره" Click="Save_Click"/><Button Style="{StaticResource GraphButton}" Content="ذخیره با نام دیگر" Click="SaveAs_Click"/><Button Style="{StaticResource GraphButton}" Content="ابزارهای تکمیلی" Click="Legacy_Click" ToolTip="محیط قبلی برای امکاناتی که هنوز به گراف منتقل نشده‌اند"/><Button Style="{StaticResource GraphButton}" Background="#0E806C" BorderBrush="#27BB9D" Content="▶  اجرای ماژول" Click="Run_Click"/></StackPanel>
        </Grid></Border>
        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="270"/></Grid.ColumnDefinitions>
            <Border Grid.Column="1" Background="#111B27" BorderBrush="#273A4C" BorderThickness="1,0,0,0"><DockPanel Margin="16,20" FlowDirection="RightToLeft"><StackPanel DockPanel.Dock="Top"><TextBlock Text="کتابخانه ماژول‌ها" FontSize="16" FontWeight="Bold"/><TextBlock Text="ماژول را به صفحه بکشید یا برای افزودن کلیک کنید" TextWrapping="Wrap" Foreground="#90A7B8" FontSize="11" Margin="0,5,0,15"/></StackPanel><ScrollViewer VerticalScrollBarVisibility="Auto"><StackPanel x:Name="ModuleLibrary"/></ScrollViewer></DockPanel></Border>
            <Grid Grid.Column="0" Background="#0C141F"><Grid.RowDefinitions><RowDefinition Height="52"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                <Border Background="#101B28" BorderBrush="#263A4B" BorderThickness="0,0,0,1"><Grid Margin="18,0"><StackPanel Orientation="Horizontal" VerticalAlignment="Center"><TextBlock Text="●" Foreground="#45D6AE" Margin="0,0,8,0"/><TextBlock Text="WORKFLOW" FontWeight="SemiBold"/><TextBlock Text=" / فضای کار" Foreground="#8FA2B6"/></StackPanel><StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center"><Button Style="{StaticResource GraphButton}" Content="−" Click="ZoomOut_Click" Padding="10,3"/><TextBlock x:Name="ZoomLabel" Text="100%" Width="55" TextAlignment="Center" VerticalAlignment="Center" Foreground="#AFC2D0"/><Button Style="{StaticResource GraphButton}" Content="+" Click="ZoomIn_Click" Padding="10,3"/><Button Style="{StaticResource GraphButton}" Content="حذف باکس" Click="Delete_Click" Padding="10,3"/></StackPanel></Grid></Border>
                <ScrollViewer x:Name="GraphScroll" Grid.Row="1" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" Background="#0D1723"><Canvas x:Name="GraphCanvas" Width="2600" Height="1700" FlowDirection="LeftToRight" AllowDrop="True" DragOver="GraphCanvas_DragOver" Drop="GraphCanvas_Drop"><Canvas.Background><DrawingBrush TileMode="Tile" Viewport="0,0,28,28" ViewportUnits="Absolute" Viewbox="0,0,28,28" ViewboxUnits="Absolute"><DrawingBrush.Drawing><DrawingGroup><GeometryDrawing Brush="#101C29" Geometry="M0,0 H28 V28 H0 Z"/><GeometryDrawing Brush="#27394A"><GeometryDrawing.Geometry><EllipseGeometry Center="2,2" RadiusX="1" RadiusY="1"/></GeometryDrawing.Geometry></GeometryDrawing></DrawingGroup></DrawingBrush.Drawing></DrawingBrush></Canvas.Background><Canvas x:Name="WireLayer" Width="2600" Height="1700" IsHitTestVisible="False"/><Canvas x:Name="NodeLayer" Width="2600" Height="1700"/></Canvas></ScrollViewer>
            </Grid>
            <ContentControl x:Name="InspectorHost" Visibility="Collapsed"><StackPanel x:Name="Inspector"/></ContentControl>
        </Grid>
        <Border Grid.Row="2" Background="#111D29" BorderBrush="#273A4C" BorderThickness="0,1,0,0"><Grid Margin="16,0"><TextBlock x:Name="Status" Text="برای شروع ماژول بارگذاری را انتخاب کنید." VerticalAlignment="Center" Foreground="#A6BDCA" FontSize="11"/><TextBlock Text="JACQUARD  /  GRAPH" HorizontalAlignment="Right" VerticalAlignment="Center" FontSize="10" Foreground="#61798C"/></Grid></Border>
    </Grid>
</Window>
