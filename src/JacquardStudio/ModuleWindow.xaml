<Window x:Class="JacquardStudio.ModuleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jacquard Studio · Workspace" Icon="Assets/app.ico"
        Width="1500" Height="900" MinWidth="1080" MinHeight="680"
        WindowStartupLocation="CenterScreen" WindowState="Maximized"
        PreviewKeyDown="Workspace_KeyDown" Background="{DynamicResource GraphBackground}"
        Foreground="{DynamicResource PrimaryText}" FontFamily="{StaticResource VazirFont}"
        Closing="Window_Closing">
    <Window.Resources>
        <Style x:Key="GraphButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="10,7"/>
            <Setter Property="Margin" Value="3,0"/>
        </Style>
        <Style x:Key="RailButton" TargetType="Button" BasedOn="{StaticResource GraphButton}">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Background" Value="{DynamicResource GraphHeader}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GraphHeader}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
        <Style x:Key="RailToggleButton" TargetType="ToggleButton">
            <Setter Property="Width" Value="38"/>
            <Setter Property="Height" Value="38"/>
            <Setter Property="MinWidth" Value="38"/>
            <Setter Property="Padding" Value="0"/>
            <Setter Property="Margin" Value="2,3"/>
            <Setter Property="Background" Value="{DynamicResource GraphHeader}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource GraphHeader}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="FontSize" Value="17"/>
        </Style>
    </Window.Resources>

    <Grid FlowDirection="LeftToRight">
        <Grid.RowDefinitions>
            <RowDefinition Height="54"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="28"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{DynamicResource GraphHeader}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <Grid Margin="14,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Image Source="Assets/sam-emblem.png" Width="37" Height="37" Stretch="Uniform" ToolTip="نشان سام"/>
                    <StackPanel Margin="10,0,0,0">
                        <TextBlock Text="JACQUARD STUDIO" FontWeight="Bold" FontSize="13"/>
                        <TextBlock Text="NODE EDITOR  /  فضای ماژولی" FontSize="9" Foreground="{DynamicResource Muted}"/>
                    </StackPanel>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="RightToLeft">
                    <Button Style="{StaticResource GraphButton}" Content="پروژه جدید" Click="New_Click"/>
                    <Button Style="{StaticResource GraphButton}" Content="باز کردن" Click="Open_Click"/>
                    <Button Style="{StaticResource GraphButton}" Content="ذخیره" Click="Save_Click"/>
                    <Button Style="{StaticResource GraphButton}" Content="ذخیره با نام" Click="SaveAs_Click"/>
                    <Button Style="{StaticResource GraphButton}" x:Name="SettingsButton" Content="تنظیمات" Click="Settings_Click"/>
                    <Button Style="{StaticResource GraphButton}" Content="راهنما" Click="Guide_Click" ToolTip="راهنمای محیط ماژولی (F1)"/>
                    <Button x:Name="CheckUpdatesButton" Style="{StaticResource GraphButton}" Content="بررسی نسخه" Click="CheckUpdates_Click" ToolTip="بررسی و دریافت به‌روزرسانی"/>
                    <Button Style="{StaticResource GraphButton}" Content="درباره" Click="About_Click"/>
                    <Button x:Name="ThemeToggle" Style="{StaticResource GraphButton}" Content="☼" Click="Theme_Click"
                            ToolTip="تغییر تم روشن / تیره" AutomationProperties.Name="تغییر تم روشن یا تیره" FontSize="17"/>
                    <Button Style="{StaticResource GraphButton}" Background="{DynamicResource ActionBackground}"
                            Foreground="{DynamicResource AccentForeground}" BorderBrush="{DynamicResource Accent}"
                            Content="▶  اجرای ماژول" Click="Run_Click"/>
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="50"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition x:Name="LibraryColumn" Width="260"/>
            </Grid.ColumnDefinitions>

            <Border x:Name="NavigationRail" Grid.Column="0" Background="{DynamicResource GraphHeader}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="0,0,1,0">
                <DockPanel Margin="3,6">
                    <StackPanel DockPanel.Dock="Bottom" HorizontalAlignment="Center">
                        <Button x:Name="HelpRailButton" Style="{StaticResource RailButton}" Content="?"
                                ToolTip="راهنما" AutomationProperties.Name="راهنما" Click="Guide_Click"/>
                        <Button x:Name="SettingsRailButton" Style="{StaticResource RailButton}" Content="&#xE713;"
                                FontFamily="Segoe MDL2 Assets" ToolTip="تنظیمات" AutomationProperties.Name="تنظیمات" Click="Settings_Click"/>
                        <Button x:Name="AboutRailButton" Style="{StaticResource RailButton}" Content="&#xE946;"
                                FontFamily="Segoe MDL2 Assets" ToolTip="درباره برنامه" AutomationProperties.Name="درباره برنامه" Click="About_Click"/>
                    </StackPanel>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Center">
                            <Button x:Name="LegacyWorkspaceButton" Style="{StaticResource RailButton}" Content="&#xE80F;"
                                    FontFamily="Segoe MDL2 Assets" ToolTip="محیط مرحله‌ای" AutomationProperties.Name="محیط مرحله‌ای" Click="Legacy_Click"/>
                            <Button x:Name="OpenRailButton" Style="{StaticResource RailButton}" Content="&#xE8B7;"
                                    FontFamily="Segoe MDL2 Assets" ToolTip="باز کردن پروژه" AutomationProperties.Name="باز کردن پروژه" Click="Open_Click"/>
                            <Button x:Name="SaveRailButton" Style="{StaticResource RailButton}" Content="&#xE74E;"
                                    FontFamily="Segoe MDL2 Assets" ToolTip="ذخیره پروژه" AutomationProperties.Name="ذخیره پروژه" Click="Save_Click"/>
                            <Border Height="1" Background="{DynamicResource Border}" Margin="5,7"/>
                            <Button x:Name="LibraryRailButton" Style="{StaticResource RailButton}" Content="&#xE8A5;"
                                    FontFamily="Segoe MDL2 Assets" ToolTip="نمایش یا پنهان کردن فهرست ماژول‌ها"
                                    AutomationProperties.Name="نمایش یا پنهان کردن فهرست ماژول‌ها" Click="LibraryToggle_Click"/>
                            <Border Height="1" Background="{DynamicResource Border}" Margin="5,7"/>
                            <Button x:Name="FitAllRailButton" Style="{StaticResource RailButton}" Content="⛶"
                                    ToolTip="همهٔ ماژول‌ها در پنجره" AutomationProperties.Name="همهٔ ماژول‌ها در پنجره" Click="FitAll_Click"/>
                            <Button x:Name="AddTextRailButton" Style="{StaticResource RailButton}" Content="T+"
                                    ToolTip="افزودن متن به فضای کار" AutomationProperties.Name="افزودن متن" Click="AddText_Click"/>
                            <Button x:Name="AddFrameRailButton" Style="{StaticResource RailButton}" Content="▣"
                                    ToolTip="افزودن کادر به فضای کار" AutomationProperties.Name="افزودن کادر" Click="AddFrame_Click"/>
                            <Button x:Name="ArrangeRailButton" Style="{StaticResource RailButton}" Content="▦"
                                    ToolTip="چیدمان ماژول‌ها در ردیف و ستون" AutomationProperties.Name="چیدمان ماژول‌ها" Click="Arrange_Click"/>
                            <Button x:Name="PresetRailButton" Style="{StaticResource RailButton}" Content="⛓"
                                    ToolTip="ساخت زنجیرهٔ عمومی" AutomationProperties.Name="زنجیرهٔ عمومی" Click="Preset_Click"/>
                            <Button x:Name="CustomPresetsRailButton" Style="{StaticResource RailButton}" Content="★"
                                    ToolTip="ذخیره و استفادهٔ دوباره از زنجیره‌های سفارشی" AutomationProperties.Name="زنجیره‌های سفارشی" Click="CustomPresets_Click"/>
                            <Button x:Name="ClearAllRailButton" Style="{StaticResource RailButton}" Content="&#xE74D;"
                                    FontFamily="Segoe MDL2 Assets" ToolTip="حذف همهٔ ماژول‌ها" AutomationProperties.Name="حذف همهٔ ماژول‌ها" Click="ClearAll_Click"/>
                            <Border Height="1" Background="{DynamicResource Border}" Margin="5,7"/>
                            <Button x:Name="ZoomOutRailButton" Style="{StaticResource RailButton}" Content="−"
                                    ToolTip="کوچک‌نمایی" AutomationProperties.Name="کوچک‌نمایی" Click="ZoomOut_Click"/>
                            <Button x:Name="ZoomInRailButton" Style="{StaticResource RailButton}" Content="+"
                                    ToolTip="بزرگ‌نمایی" AutomationProperties.Name="بزرگ‌نمایی" Click="ZoomIn_Click"/>
                            <Button x:Name="DeleteRailButton" Style="{StaticResource RailButton}" Content="⌫"
                                    ToolTip="حذف مورد انتخاب‌شده" AutomationProperties.Name="حذف مورد انتخاب‌شده" Click="Delete_Click"/>
                            <ToggleButton x:Name="AlertAnimations" Style="{StaticResource RailToggleButton}" Content="⚠"
                                          IsChecked="True" ToolTip="چشمک هشدار را خاموش یا روشن کنید" AutomationProperties.Name="چشمک هشدار"/>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>

            <Grid Grid.Column="1" x:Name="WorkspaceMain">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*"/>
                    <RowDefinition x:Name="InspectorRow" Height="150"/>
                </Grid.RowDefinitions>
                <Grid Grid.Row="0" Background="{DynamicResource GraphBackground}">
                    <ScrollViewer x:Name="GraphScroll" PreviewMouseDown="GraphScroll_MouseDown"
                                  PreviewMouseMove="GraphScroll_MouseMove" PreviewMouseUp="GraphScroll_MouseUp"
                                  LostMouseCapture="GraphScroll_LostMouseCapture" PreviewMouseWheel="GraphScroll_MouseWheel"
                                  HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto"
                                  Background="{DynamicResource GraphBackground}">
                        <Canvas x:Name="GraphCanvas" Width="2600" Height="1700" FlowDirection="LeftToRight"
                                AllowDrop="True" DragOver="GraphCanvas_DragOver" Drop="GraphCanvas_Drop">
                            <Canvas.Background>
                                <DrawingBrush TileMode="Tile" Viewport="0,0,14,14" ViewportUnits="Absolute"
                                              Viewbox="0,0,14,14" ViewboxUnits="Absolute">
                                    <DrawingBrush.Drawing>
                                        <DrawingGroup>
                                            <GeometryDrawing Brush="{DynamicResource GraphBackground}" Geometry="M0,0 H14 V14 H0 Z"/>
                                            <GeometryDrawing Brush="{DynamicResource GraphGrid}">
                                                <GeometryDrawing.Geometry>
                                                    <GeometryGroup><EllipseGeometry Center="1,1" RadiusX="0.7" RadiusY="0.7"/></GeometryGroup>
                                                </GeometryDrawing.Geometry>
                                            </GeometryDrawing>
                                        </DrawingGroup>
                                    </DrawingBrush.Drawing>
                                </DrawingBrush>
                            </Canvas.Background>
                            <Canvas x:Name="AnnotationLayer" Width="2600" Height="1700"/>
                            <Canvas x:Name="WireLayer" Width="2600" Height="1700"/>
                            <Canvas x:Name="NodeLayer" Width="2600" Height="1700"/>
                        </Canvas>
                    </ScrollViewer>
                    <Image x:Name="WorkspaceEmblem" Source="Assets/sam-emblem.png" Width="440" Height="440"
                           Stretch="Uniform" Opacity="0.045" HorizontalAlignment="Center" VerticalAlignment="Center"
                           IsHitTestVisible="False"/>
                </Grid>

                <Border x:Name="InspectorBorder" Grid.Row="1" Background="{DynamicResource Surface}"
                        BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
                    <Grid>
                        <Grid.RowDefinitions><RowDefinition Height="32"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Border Background="{DynamicResource GraphHeader}" BorderBrush="{DynamicResource Border}"
                                BorderThickness="0,0,0,1">
                            <Grid FlowDirection="RightToLeft" Margin="8,0">
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Button x:Name="InspectorToggleButton" Style="{StaticResource GraphButton}" Content="⌄"
                                            Click="InspectorToggle_Click" Width="30" Height="26" Padding="0" Margin="0,0,8,0"
                                            ToolTip="جمع یا باز کردن بازرس" AutomationProperties.Name="جمع یا باز کردن بازرس"/>
                                    <TextBlock Text="تنظیمات ماژول" FontWeight="SemiBold" VerticalAlignment="Center"/>
                                    <Border Width="1" Height="18" Background="{DynamicResource Border}" Margin="10,0"/>
                                    <TextBlock x:Name="InspectorSelectionTitle" Text="یک ماژول را انتخاب کنید" Foreground="{DynamicResource Muted}"
                                               FontSize="12" VerticalAlignment="Center"/>
                                </StackPanel>
                            </Grid>
                        </Border>
                        <ContentControl x:Name="InspectorHost" Grid.Row="1" Background="{DynamicResource Surface}">
                            <ScrollViewer x:Name="InspectorScrollHost" HorizontalScrollBarVisibility="Disabled"
                                          VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                                <StackPanel x:Name="Inspector" Orientation="Vertical" FlowDirection="RightToLeft" Margin="6,4"/>
                            </ScrollViewer>
                        </ContentControl>
                    </Grid>
                </Border>
            </Grid>

            <Border x:Name="LibraryPanel" Grid.Column="2" Background="{DynamicResource GraphSurface}"
                    BorderBrush="{DynamicResource Border}" BorderThickness="1,0,0,0">
                <DockPanel Margin="10,12" FlowDirection="RightToLeft">
                    <StackPanel DockPanel.Dock="Top" Margin="2,0,2,8">
                        <TextBlock Text="لیست ماژول‌ها" FontSize="15" FontWeight="SemiBold"/>
                        <TextBlock Text="برای افزودن کلیک کنید یا ماژول را به بوم بکشید."
                                   TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="11" Margin="0,4,0,8"/>
                        <Border Height="1" Background="{DynamicResource Border}"/>
                    </StackPanel>
                    <TextBlock DockPanel.Dock="Bottom" Text="دوبار کلیک روی گره: تنظیمات"
                               TextWrapping="Wrap" Foreground="{DynamicResource Muted}" FontSize="10" Margin="2,8,2,0"/>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel x:Name="ModuleLibrary"/>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <Border Grid.Row="2" Background="{DynamicResource GraphHeader}"
                BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0">
            <Grid Margin="12,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <TextBlock x:Name="Status" Grid.Column="0" Text="برای شروع ماژول بارگذاری را باز کنید."
                           VerticalAlignment="Center" HorizontalAlignment="Left" Margin="0,0,12,0"
                           Foreground="{DynamicResource Muted}" FontSize="11" TextTrimming="CharacterEllipsis"/>
                <TextBlock x:Name="StatusMetadata" Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center"
                           FlowDirection="RightToLeft" Foreground="{DynamicResource Muted}" FontSize="10"
                           TextTrimming="CharacterEllipsis" AutomationProperties.Name="نسخه، ماژول‌های فعال و مالک نرم‌افزار"/>
            </Grid>
        </Border>
    </Grid>
</Window>
