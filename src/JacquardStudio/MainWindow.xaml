        <Grid x:Name="BankWorkspace" Grid.Row="2" Margin="22" Visibility="Collapsed" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BankTitle" Text="بانک و طراحی بافت" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="BankHint" Text="یک بافت انتخاب کنید یا روی شبکه ترسیم کنید." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="BankBackButton" Content="بازگشت" Click="BankBack_Click" Padding="14,7"/></Grid>
            <Grid Grid.Row="1" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="350" MinWidth="260"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="EditorTitle" Text="طراحی بافت" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EditorHint" Text="روی خانه‌ها کلیک کنید یا بکشید؛ سیاه و سفید تغییر می‌کنند." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/>
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="WeaveWidthLabel" Text="عرض" VerticalAlignment="Center"/><TextBox x:Name="WeaveWidth" Text="8" Width="55" Margin="6,0,12,0" Padding="5" FlowDirection="LeftToRight"/><TextBlock x:Name="WeaveHeightLabel" Text="ارتفاع" VerticalAlignment="Center"/><TextBox x:Name="WeaveHeight" Text="8" Width="55" Margin="6,0,12,0" Padding="5" FlowDirection="LeftToRight"/><Button x:Name="EditorResetButton" Content="ساخت شبکه" Click="EditorReset_Click" Padding="10,6"/><Button x:Name="Editor3DButton" Content="3D" Click="Editor3D_Click" Margin="6,0,0,0" ToolTip="نمای سه‌بعدی بافت ترسیم‌شده"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#DCE3E8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,14" Padding="8" CornerRadius="5"><ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight"><local:WeaveEditor x:Name="WeaveCanvas" FlowDirection="LeftToRight" HorizontalAlignment="Center" VerticalAlignment="Center"/></ScrollViewer></Border>
                    <StackPanel Grid.Row="2"><WrapPanel FlowDirection="LeftToRight" Margin="0,0,0,6">
                        <TextBlock Text="ΔX" VerticalAlignment="Center"/><TextBox x:Name="StepXInput" Text="1" Width="40" Padding="3" Margin="4"/><TextBlock Text="ΔY" VerticalAlignment="Center"/><TextBox x:Name="StepYInput" Text="1" Width="40" Padding="3" Margin="4"/>
                        <Button Content="↗" Tag="NE" ToolTip="قطر رو به بالا و راست" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↖" Tag="NW" ToolTip="قطر رو به بالا و چپ" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↘" Tag="SE" ToolTip="قطر رو به پایین و راست" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↙" Tag="SW" ToolTip="قطر رو به پایین و چپ" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <Button Content="▞" Tag="plain" ToolTip="بافت ساده شطرنجی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="╱" Tag="twillRight" ToolTip="ادامه تار اول؛ یک خانه رو به بالا" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="╲" Tag="twillLeft" ToolTip="ادامه تار اول؛ یک خانه رو به پایین" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <Button Content="پاناما" Tag="panama" ToolTip="پاناما: چهار قسمت؛ بالا راست و پایین چپ مشکی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="ساتین" Tag="satin" ToolTip="ساتین با تکرار و گام انتخابی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <TextBlock Text="ساتین N:" VerticalAlignment="Center"/><TextBox x:Name="SatinRepeat" Text="5" Width="36" Padding="3" Margin="2"/><TextBlock Text="گام:" VerticalAlignment="Center"/><TextBox x:Name="SatinStep" Text="2" Width="36" Padding="3" Margin="2"/>
                        <Button Content="◐" Tag="invert" ToolTip="معکوس سیاه و سفید" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="⇋" Tag="mirrorX" ToolTip="قرینه افقی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="⇅" Tag="mirrorY" ToolTip="قرینه عمودی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="□" Tag="clear" ToolTip="پاک کردن شبکه" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="▦" ToolTip="نمایش یا پنهان کردن خطوط شبکه" Click="EditorGrid_Click" Padding="7,3" Margin="2"/>
                        <Button Content="↶" ToolTip="بازگشت ترسیم" Click="Undo_Click" Padding="7,3" Margin="2"/><Button Content="↷" ToolTip="بازانجام ترسیم" Click="Redo_Click" Padding="7,3" Margin="2"/>
                    </WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WeaveName" Text="بافت جدید" Padding="8" Margin="0,0,8,0"/><Button Grid.Column="1" x:Name="BankSaveDrawingButton" Content="ذخیره در بانک" Click="BankSaveDrawing_Click" Padding="14,7"/></Grid></StackPanel>
                </Grid></Border>
                <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="BankListTitle" Text="بافت‌های بانک" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BankStatus" Foreground="{DynamicResource Muted}" Margin="0,5,0,10" TextWrapping="Wrap"/><ComboBox x:Name="BankCategory" SelectionChanged="BankCategory_Changed" Margin="0,0,0,8" ToolTip="دسته بافت"/></StackPanel>
                    <ListBox x:Name="BankList" Grid.Row="1" Background="{DynamicResource ListBackground}" Foreground="{DynamicResource PrimaryText}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BankSelection_Changed" ItemsPanel="{StaticResource WeaveGalleryPanel}" ItemTemplate="{StaticResource WeaveGalleryItem}" ItemContainerStyle="{StaticResource WeaveGalleryListItem}"/>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BankUseButton" Content="اختصاص به رنگ" Click="BankUse_Click" IsEnabled="False" Margin="0,0,0,6"/><Button x:Name="CompositeButton" Content="ساخت و تجزیه بافت ترکیبی" Click="Composite_Click" Margin="0,0,0,6"/><Button x:Name="Bank3DButton" Content="نمای سه‌بعدی انتخاب‌شده" Click="Bank3D_Click" Margin="0,0,0,6"/><Button x:Name="BankEditButton" Content="ویرایش انتخاب‌شده" Click="BankEdit_Click" IsEnabled="False" Margin="0,0,0,6"/><Button x:Name="BankImportButton" Content="افزودن از فایل BMP/TIFF" Click="BankImport_Click" Margin="0,0,0,6"/><Button x:Name="BankDeleteButton" Content="حذف از بانک" Click="BankDelete_Click" IsEnabled="False"/></StackPanel>
                </Grid></Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="آماده برای باز کردن تصویر" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StatsText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0"/><TextBlock x:Name="DeveloperText" Grid.Column="2" Text="برنامه‌نویس: میرخلیلی" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="16,0"/><TextBlock x:Name="VersionText" Grid.Column="3" FlowDirection="LeftToRight" VerticalAlignment="Center" Foreground="#73879B" FontSize="11"/></Grid></Border>
    </Grid>
</Window>
