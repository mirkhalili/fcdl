<Window FontFamily="{StaticResource VazirFont}" x:Class="JacquardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JacquardStudio"
        Title="Jacquard Studio" Width="1320" Height="820" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" FontSize="14" Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" FlowDirection="RightToLeft" PreviewKeyDown="Window_KeyDown" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" FlowDirection="LeftToRight" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="CloseWindowButton" Content="✕" ToolTip="بستن" AutomationProperties.Name="Close" Click="CloseWindow_Click" Width="44" Height="32" Background="#71343D" Padding="0"/>
                    <Button x:Name="MaximizeWindowButton" Content="□" ToolTip="بزرگ‌نمایی / بازگردانی" AutomationProperties.Name="Maximize or restore" Click="MaximizeWindow_Click" Width="44" Height="32" Padding="0"/>
                    <Button x:Name="MinimizeWindowButton" Content="−" ToolTip="کمینه کردن" AutomationProperties.Name="Minimize" Click="MinimizeWindow_Click" Width="44" Height="32" Padding="0"/>
                </StackPanel>
                <TextBlock x:Name="WindowTitleText" Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0">
                <Button x:Name="LanguageButton" Content="EN" ToolTip="تغییر زبان" AutomationProperties.Name="Change language" Click="Language_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="ThemeButton" Content="☼" ToolTip="تغییر تم" AutomationProperties.Name="Change theme" Click="Theme_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="OpenProjectButton" Content="&#xE8E5;" FontFamily="Segoe MDL2 Assets" ToolTip="باز کردن پروژه" AutomationProperties.Name="Open project" Click="OpenProject_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="SaveProjectButton" Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" ToolTip="ذخیره پروژه" AutomationProperties.Name="Save project" Click="SaveProject_Click" Width="48" Height="42" Padding="4" Margin="3" IsEnabled="False"/>
                <Button x:Name="SaveProjectAsButton" Content="&#xE792;" FontFamily="Segoe MDL2 Assets" ToolTip="ذخیره با نام دیگر" AutomationProperties.Name="Save project as" Click="SaveProjectAs_Click" Width="48" Height="42" Padding="4" Margin="3" IsEnabled="False"/>
                <Button x:Name="UndoButton" Content="↶" ToolTip="بازگشت (Ctrl+Z)" AutomationProperties.Name="Undo" Click="Undo_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="20"/>
                <Button x:Name="RedoButton" Content="↷" ToolTip="بازانجام (Ctrl+Y)" AutomationProperties.Name="Redo" Click="Redo_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="20"/>
                <Button x:Name="InfoButton" Content="اطلاعات طرح" ToolTip="طراح، کاربرد و توضیحات" AutomationProperties.Name="Design information" Click="Info_Click" Height="42" Padding="10,4" Margin="3"/>
                <Button x:Name="ReportButton" Content="&#xE749;" FontFamily="Segoe MDL2 Assets" ToolTip="گزارش PDF و چاپ" AutomationProperties.Name="PDF report and printing" Click="Report_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="BankButton" Content="▦" ToolTip="بانک و طراحی بافت" AutomationProperties.Name="Weave bank" Click="Bank_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="24"/>
                <Button x:Name="AboutButton" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" ToolTip="درباره" AutomationProperties.Name="About" Click="About_Click" Width="48" Height="42" Padding="4" Margin="3"/>
            </StackPanel>
        </Border>
        <Grid x:Name="WorkflowRoot" Grid.Row="2" Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="Navigation" Margin="0,0,0,16" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Grid.Column="0" Content="+  باز کردن تصویر" Click="Open_Click" Margin="0,0,8,0" Background="#36C9AB" BorderBrush="#36C9AB" Foreground="#082621" FontWeight="Bold"/>
                <Button x:Name="SizeStepButton" Grid.Column="1" Content="۱  تغییر اندازه" Click="SizeStep_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="ColorStepButton" Grid.Column="2" Content="۲  کاهش رنگ" Click="ColorStep_Click" Margin="0,0,8,0" IsEnabled="False"/>
                <Button x:Name="PatternStepButton" Grid.Column="3" Content="۳  اختصاص بافت" Click="PatternStep_Click" IsEnabled="False" Margin="0,0,8,0"/>
                <Button x:Name="MachineStepButton" Grid.Column="4" Content="۴  فایل ماشین" Click="MachineStep_Click" Margin="0,0,8,0"/>
                <Button x:Name="AnalysisStepButton" Grid.Column="5" Content="۵  تحلیل تار" Click="AnalysisStep_Click" Margin="0,0,8,0" Padding="5,8" IsEnabled="False"/>
                <Button x:Name="FloatStepButton" Grid.Column="6" Content="۶  بررسی فلوت" Click="FloatStep_Click" Padding="5,8" IsEnabled="False"/>
            </Grid>
            <!-- Physical right: settings; left: preview. -->
            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="10"/><ColumnDefinition Width="355" MinWidth="270"/></Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Border}" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize panels"/>
                <Border Grid.Column="2" x:Name="SettingsBorder" FlowDirection="RightToLeft" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid><Grid x:Name="RegularSettings"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock x:Name="FileCaption" Text="فایل ورودی" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="FileValue" Text="—" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Margin="0,6,0,6"/><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,0,12"><Button x:Name="PreviousPage" Content="‹" Click="PreviousPage_Click" Width="36" Padding="6" IsEnabled="False"/><TextBlock x:Name="PageValue" Text="—" Width="78" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="NextPage" Content="›" Click="NextPage_Click" Width="36" Padding="6" IsEnabled="False"/><TextBlock x:Name="FormatValue" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><Border Height="1" Background="{DynamicResource Border}"/></StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel x:Name="NoFilePanel"><TextBlock x:Name="NoFileTitle" Text="شروع کار" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NoFileHint" Text="ابتدا یک تصویر BMP یا TIFF باز کنید یا در پنجره رها کنید." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
                            <StackPanel x:Name="SizePanel" Visibility="Collapsed">
                                <TextBlock x:Name="SizeTitle" Text="مرحله ۱ · تغییر اندازه" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SizeHint" Text="ابعاد خروجی را وارد و اعمال کنید. تصویر سمت چپ نتیجه همین مرحله است." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WidthLabel" Text="عرض (پیکسل)"/><TextBox x:Name="WidthInput" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,5,0" Padding="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="HeightLabel" Text="ارتفاع (پیکسل)"/><TextBox x:Name="HeightInput" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,0,0" Padding="7"/></StackPanel></Grid>
                                <Button x:Name="ApplySizeButton" Content="اعمال اندازه" Click="ApplySize_Click" Margin="0,16,0,0"/>
                                <Button x:Name="SaveSizeButton" Content="ذخیره خروجی اندازه" Click="Save_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <Button x:Name="ToColorButton" Content="مرحله بعد: رنگ ←" Click="ColorStep_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <TextBlock x:Name="SizeNotice" Text="روش تغییر اندازه نزدیک‌ترین همسایه است؛ نسبت تصویر خودکار حفظ نمی‌شود." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="12"/>
                            </StackPanel>
                            <ScrollViewer x:Name="ColorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ColorPanel" Visibility="Collapsed">
                                <TextBlock x:Name="ColorTitle" Text="مرحله ۲ · کاهش رنگ" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ColorHint" Text="ورودی این مرحله تصویر تغییراندازه‌یافته است؛ بیش از ۵۰ رنگ به‌طور خودکار کاهش می‌یابد." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,16"/>
                                <TextBlock x:Name="ColorLimitLabel" Text="حداکثر تعداد رنگ (۱ تا ۵۰)"/><TextBox x:Name="ColorInput" Text="50" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,0,0" Padding="7"/>
                                <Button x:Name="ApplyColorButton" Content="اعمال تعداد رنگ" Click="ApplyColor_Click" Margin="0,14,0,0"/>
                                <TextBlock x:Name="ColorSummary" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,8"/>
                                <ListView x:Name="ColorPaletteList" Height="175" Background="{DynamicResource HeaderBackground}" BorderThickness="0" SelectionMode="Multiple" SelectionChanged="ColorSelection_Changed" FlowDirection="RightToLeft" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.View><GridView>
                                        <GridViewColumn x:Name="ColorSwatchColumn" Header="رنگ" Width="46"><GridViewColumn.CellTemplate><DataTemplate><Border Width="25" Height="25" Background="{Binding Brush}" BorderBrush="#A0A0A0" BorderThickness="1" CornerRadius="4"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                        <GridViewColumn x:Name="ColorCodeColumn" Header="کد رنگ" Width="80" DisplayMemberBinding="{Binding ColorCode}"/>
                                        <GridViewColumn x:Name="ColorCountColumn" Header="پیکسل" Width="75" DisplayMemberBinding="{Binding PixelCountText}"/>
                                        <GridViewColumn x:Name="ColorPercentColumn" Header="درصد" Width="55" DisplayMemberBinding="{Binding PercentText}"/>
                                    </GridView></ListView.View>
                                </ListView>
                                <TextBlock x:Name="ColorSelectionHint" Text="برای ادغام، دو رنگ را انتخاب کنید." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="DeleteColorButton" Content="حذف رنگ انتخابی" Click="DeleteColor_Click" IsEnabled="False" Margin="0,0,4,0" Padding="6,8"/>
                                    <Button x:Name="MergeColorButton" Grid.Column="1" Content="ادغام با مقصد" Click="MergeColor_Click" IsEnabled="False" Padding="6,8"/>
                                </Grid>
                                <Button x:Name="SaveColorButton" Content="ذخیره خروجی رنگ" Click="Save_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <Button x:Name="ToPatternButton" Content="مرحله بعد: بافت ←" Click="PatternStep_Click" Margin="0,14,0,0" IsEnabled="False"/>
                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="AnalysisPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock x:Name="AnalysisTitle" Text="تحلیل تارها" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AnalysisHint" Text="تعداد نقاط سیاه هر ستون با میانگین همه ستون‌ها مقایسه می‌شود. قرمز: بالاتر؛ آبی: پایین‌تر. این شاخص، اندازه‌گیری فیزیکی کشش نیست." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                <Button x:Name="RunAnalysisButton" Content="محاسبه نقشه حرارتی" Click="RunAnalysis_Click"/><TextBlock x:Name="AnalysisResultText" Text="برای محاسبه، دکمه بالا را بزنید." Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,0"/>
                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="FloatPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock x:Name="FloatTitle" Text="بررسی فلوت" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FloatHint" Text="طول حداقل و جهت را انتخاب کنید؛ همه دنباله‌های سیاه یا سفیدِ پیوسته در خط انتخابی شمرده می‌شوند. روی تصویر کلیک کنید تا نقطه عوض شود." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                <TextBlock x:Name="FloatLengthLabel" Text="حداقل طول فلوت"/><TextBox x:Name="FloatMinimum" Text="10" TextChanged="FloatParameters_Changed" FlowDirection="LeftToRight" Padding="7" Margin="0,5,0,8"/>
                                <RadioButton x:Name="FloatWarp" Content="تار (ستون)" GroupName="FloatDirection" Checked="FloatDirection_Changed" IsChecked="True" Margin="0,3"/><RadioButton x:Name="FloatWeft" Content="پود (ردیف)" GroupName="FloatDirection" Checked="FloatDirection_Changed" Margin="0,3"/>
                                <Button x:Name="FloatScanButton" Content="بررسی فلوت‌ها" Click="FloatScan_Click" Margin="0,10,0,0"/><TextBlock x:Name="FloatResultText" Text="هنوز بررسی نشده است." Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,8"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="FloatPreviousButton" Content="قبلی" Click="FloatPrevious_Click" Margin="0,0,4,0" IsEnabled="False"/><Button x:Name="FloatNextButton" Grid.Column="1" Content="بعدی" Click="FloatNext_Click" Margin="4,0,0,0" IsEnabled="False"/></Grid>
                                <TextBlock x:Name="FloatCurrentText" TextWrapping="Wrap" Margin="0,12,0,0"/>
                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="MachineScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="MachinePanel" Visibility="Collapsed">
                                <TextBlock x:Name="MachineTitle" Text="مرحله ۴ · فایل ماشین" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="MachineHint" Text="خواندن و نوشتن قالب‌های زیر هنوز تأیید و پیاده‌سازی نشده است. تغییر پسوند، تبدیل فایل نیست." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,16"/>
                                <TextBlock x:Name="MachineFormatLabel" Text="قالب هدف (پشتیبانی‌نشده)" Foreground="{DynamicResource Muted}" Margin="0,0,0,6"/>
                                <UniformGrid x:Name="MachineTiles" Columns="5" FlowDirection="LeftToRight" Margin="0,0,0,14">
                                    <RadioButton x:Name="FormatJC4" GroupName="Machine" Tag="0" Checked="MachineFormat_Checked" ToolTip="JC4: unsupported"><StackPanel><Border Width="48" Height="55" Background="#22464C" CornerRadius="6" Margin="3"><TextBlock Text="JC4" Foreground="#8AE9D3" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JC4" HorizontalAlignment="Center" FontSize="10"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="FormatJC5" GroupName="Machine" IsChecked="True" Tag="1" Checked="MachineFormat_Checked" ToolTip="JC5: experimental single-area"><StackPanel><Border Width="48" Height="55" Background="#293E64" CornerRadius="6" Margin="3"><TextBlock Text="JC5" Foreground="#A5C5FF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JC5" HorizontalAlignment="Center" FontSize="10"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="FormatJC6" GroupName="Machine" Tag="4" Checked="MachineFormat_Checked" ToolTip="JC6: experimental sample profile"><StackPanel><Border Width="42" Height="55" Background="#31516D" CornerRadius="6" Margin="3"><TextBlock Text="JC6" Foreground="#B5DDFF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="JC6" HorizontalAlignment="Center" FontSize="10"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="FormatZC5" GroupName="Machine" Tag="2" Checked="MachineFormat_Checked" ToolTip="ZC5: unsupported"><StackPanel><Border Width="48" Height="55" Background="#504060" CornerRadius="6" Margin="3"><TextBlock Text="ZC5" Foreground="#DEC2FA" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="ZC5" HorizontalAlignment="Center" FontSize="10"/></StackPanel></RadioButton>
                                    <RadioButton x:Name="FormatEP" GroupName="Machine" Tag="3" Checked="MachineFormat_Checked" ToolTip="Bonas EP: unsupported"><StackPanel><Border Width="48" Height="55" Background="#5A4431" CornerRadius="6" Margin="3"><TextBlock Text="EP" Foreground="#FFD09C" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock Text="EP" HorizontalAlignment="Center" FontSize="10"/></StackPanel></RadioButton>
                                </UniformGrid>
                                <CheckBox x:Name="MachineUseSource" Content="استفاده از تصویر اصلی سیاه‌وسفید" Margin="0,0,0,12" Checked="MachineSource_Changed" Unchecked="MachineSource_Changed"/>
                                <CheckBox x:Name="MachineRedAsBlack" Content="نقشه قرمز و سفید: قرمز = بافت" Margin="0,0,0,12"/>
                                <Button x:Name="MachineExportButton" Content="تبدیل و ذخیره فایل ماشین" IsEnabled="False" Click="MachineExport_Click"/>
                                <CheckBox x:Name="MachineLegacyImport" Content="خواندن فایل خروجی نسخه قدیمی ۰۰۶" Margin="0,10,0,0"/>
                                <Button x:Name="MachineImportButton" Content="انتخاب فایل ماشین" Click="MachineImport_Click" Margin="0,10,0,0"/>
                                <TextBlock x:Name="MachineNotice" Text="برای فعال شدن تبدیل یا خواندن، نمونه فایل واقعی، مدل کنترلر و مشخصات معتبر لازم است." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,16,0,0"/>
                            </StackPanel></ScrollViewer>
                        </Grid>
                        <TextBlock Grid.Row="2" x:Name="SafetyText" Text="خروجی تصویر است، نه فایل دستگاه بافندگی." Foreground="{DynamicResource Accent}" TextWrapping="Wrap" FontSize="12" Margin="0,12,0,0"/>
                    </Grid>
                    <Grid x:Name="PatternWorkspace" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock x:Name="AssignedText" Foreground="{DynamicResource Accent}" VerticalAlignment="Center" TextWrapping="Wrap"/>
                            <Button Grid.Column="1" x:Name="SaveButton" Content="ذخیره تصویر" Click="Save_Click" IsEnabled="False" Background="#36C9AB" BorderBrush="#36C9AB" Foreground="#082621" Padding="10,7"/>
                        </Grid>
                    <Border x:Name="PatternGallery" Grid.Row="1" Background="{DynamicResource GalleryBackground}" BorderBrush="#354B5C" BorderThickness="1" CornerRadius="10" Padding="8" Margin="0" FlowDirection="RightToLeft">
                        <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" CanContentScroll="False">
                            <ItemsControl x:Name="PatternCards">
                                <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate><DataTemplate>
                                    <Border Background="#EDF0F1" BorderBrush="#7F929D" BorderThickness="1" CornerRadius="4" Margin="3" Width="138">
                                        <StackPanel>
                                            <Border Background="White" Height="115" Margin="5" BorderBrush="#ADB7BA" BorderThickness="1"><Image Source="{Binding PatternGridPreview}" Width="105" Height="105" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border>
                                            <Grid Height="28" Background="#D6DBDD"><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Background="{Binding Brush}"><TextBlock Text="{Binding ColorNumber}" Foreground="{Binding ColorNumberForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" FontWeight="Bold"/></Border><TextBlock Grid.Column="1" Text="{Binding PatternSize}" Foreground="#172432" HorizontalAlignment="Center" VerticalAlignment="Center" FlowDirection="LeftToRight"/></Grid>
                                            <TextBlock Text="{Binding PatternLabel}" Foreground="#172432" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="3,4" FlowDirection="LeftToRight"/>
                                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,2,0,5"><Button Content="الگوها" ToolTip="Choose built-in pattern" Click="PatternPreset_Click" Padding="6,3" Margin="2"/><Button Content="فایل…" ToolTip="Choose pattern file" Click="Pattern_Click" Padding="6,3" Margin="2"/><Button Content="بانک" ToolTip="Choose from weave bank" Click="PatternBank_Click" Padding="6,3" Margin="2"/></StackPanel>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate></ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>
                    </Border>
                    </Grid>
                    </Grid>
                </Border>
                <Grid Grid.Column="0" FlowDirection="RightToLeft">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Grid Margin="0,0,0,12"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="CanvasTitle" Text="پیش‌نمایش طرح" FontSize="21" FontWeight="SemiBold"/><TextBlock x:Name="CanvasSubtitle" Text="خروجی هر مرحله در این قسمت نمایش داده می‌شود" Foreground="{DynamicResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel><StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight"><Button Content="−" Click="ZoomOut_Click" Width="40" Padding="6"/><TextBlock x:Name="ZoomText" Text="100%" Width="58" TextAlignment="Center" VerticalAlignment="Center"/><Button Content="+" Click="ZoomIn_Click" Width="40" Padding="6"/><Button Content="100%" Click="ZoomReset_Click" Padding="10,6" Margin="6,0,0,0"/></StackPanel></Grid>
                    <Border Grid.Row="2" Background="{DynamicResource CanvasBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True"><Grid><ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Visibility="Collapsed"><Image x:Name="PreviewImage" ToolTipService.InitialShowDelay="0" MouseMove="PreviewImage_MouseMove" MouseLeave="PreviewImage_MouseLeave" MouseLeftButtonDown="PreviewImage_Click" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/></ScrollViewer><StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350"><Border Width="72" Height="72" Background="#172A36" BorderBrush="#2E5C5C" BorderThickness="1" CornerRadius="22"><TextBlock Text="▦" Foreground="#59DBBF" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><TextBlock x:Name="EmptyTitle" Text="طرح خود را وارد کنید" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,8"/><TextBlock x:Name="EmptyHint" Text="یک تصویر BMP یا TIFF انتخاب کنید." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}"/><Button x:Name="EmptyButton" Content="انتخاب تصویر" Click="Open_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/></StackPanel><Border x:Name="HoverCard" Visibility="Collapsed" VerticalAlignment="Bottom" HorizontalAlignment="Left" Margin="12" Padding="10" CornerRadius="7" Background="#DD142332" IsHitTestVisible="False"><TextBlock x:Name="HoverDetails" Foreground="White" FontSize="12" TextWrapping="Wrap"/></Border></Grid></Border>
                    <TextBlock Grid.Row="3" x:Name="PreviewDetails" Foreground="{DynamicResource Muted}" FontSize="12" Margin="2,10,2,0" FlowDirection="LeftToRight"/>
                </Grid>
            </Grid>
        </Grid>
        <Grid x:Name="BankWorkspace" Grid.Row="2" Margin="22" Visibility="Collapsed" FlowDirection="RightToLeft">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="0,0,0,14"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="BankTitle" Text="بانک و طراحی بافت" FontSize="20" FontWeight="Bold"/><TextBlock x:Name="BankHint" Text="یک بافت انتخاب کنید یا روی شبکه ترسیم کنید." Foreground="{DynamicResource Muted}" Margin="0,4,0,0"/></StackPanel><Button Grid.Column="1" x:Name="BankBackButton" Content="بازگشت" Click="BankBack_Click" Padding="14,7"/></Grid>
            <Grid Grid.Row="1" FlowDirection="LeftToRight"><Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="300"/><ColumnDefinition Width="12"/><ColumnDefinition Width="350" MinWidth="260"/></Grid.ColumnDefinitions>
                <Border Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="16" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="EditorTitle" Text="طراحی بافت" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="EditorHint" Text="روی خانه‌ها کلیک کنید یا بکشید؛ سیاه و سفید تغییر می‌کنند." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,5,0,10"/>
                        <StackPanel Orientation="Horizontal"><TextBlock x:Name="WeaveWidthLabel" Text="عرض" VerticalAlignment="Center"/><TextBox x:Name="WeaveWidth" Text="8" Width="55" Margin="6,0,12,0" Padding="5" FlowDirection="LeftToRight"/><TextBlock x:Name="WeaveHeightLabel" Text="ارتفاع" VerticalAlignment="Center"/><TextBox x:Name="WeaveHeight" Text="8" Width="55" Margin="6,0,12,0" Padding="5" FlowDirection="LeftToRight"/><Button x:Name="EditorResetButton" Content="ساخت شبکه" Click="EditorReset_Click" Padding="10,6"/></StackPanel>
                    </StackPanel>
                    <Border Grid.Row="1" Background="#DCE3E8" BorderBrush="{DynamicResource Border}" BorderThickness="1" Margin="0,14" Padding="8" CornerRadius="5"><local:WeaveEditor x:Name="WeaveCanvas" FlowDirection="LeftToRight" MinWidth="150" MinHeight="150"/></Border>
                    <StackPanel Grid.Row="2"><WrapPanel FlowDirection="LeftToRight" Margin="0,0,0,6">
                        <TextBlock Text="ΔX" VerticalAlignment="Center"/><TextBox x:Name="StepXInput" Text="1" Width="40" Padding="3" Margin="4"/><TextBlock Text="ΔY" VerticalAlignment="Center"/><TextBox x:Name="StepYInput" Text="1" Width="40" Padding="3" Margin="4"/>
                        <Button Content="↗" Tag="NE" ToolTip="قطر رو به بالا و راست" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↖" Tag="NW" ToolTip="قطر رو به بالا و چپ" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↘" Tag="SE" ToolTip="قطر رو به پایین و راست" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="↙" Tag="SW" ToolTip="قطر رو به پایین و چپ" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <Button Content="▞" Tag="plain" ToolTip="بافت ساده شطرنجی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="╱" Tag="twillRight" ToolTip="ادامه ردیف اول؛ قطر رو به بالا (هر ردیف یک خانه به چپ)" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="╲" Tag="twillLeft" ToolTip="ادامه ردیف اول؛ قطر رو به پایین (هر ردیف یک خانه به راست)" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <Button Content="پاناما" Tag="panama" ToolTip="پاناما ۲×۲؛ ابعاد مضرب ۴" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="ساتین" Tag="satin" ToolTip="ساتین پنج‌تایی با گام ۲؛ ابعاد مضرب ۵" Click="EditorHelper_Click" Padding="7,3" Margin="2"/>
                        <Button Content="◐" Tag="invert" ToolTip="معکوس سیاه و سفید" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="⇋" Tag="mirrorX" ToolTip="قرینه افقی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="⇅" Tag="mirrorY" ToolTip="قرینه عمودی" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="□" Tag="clear" ToolTip="پاک کردن شبکه" Click="EditorHelper_Click" Padding="7,3" Margin="2"/><Button Content="▦" ToolTip="نمایش یا پنهان کردن خطوط شبکه" Click="EditorGrid_Click" Padding="7,3" Margin="2"/>
                        <Button Content="↶" ToolTip="بازگشت ترسیم" Click="Undo_Click" Padding="7,3" Margin="2"/><Button Content="↷" ToolTip="بازانجام ترسیم" Click="Redo_Click" Padding="7,3" Margin="2"/>
                    </WrapPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBox x:Name="WeaveName" Text="بافت جدید" Padding="8" Margin="0,0,8,0"/><Button Grid.Column="1" x:Name="BankSaveDrawingButton" Content="ذخیره در بانک" Click="BankSaveDrawing_Click" Padding="14,7"/></Grid></StackPanel>
                </Grid></Border>
                <Border Grid.Column="2" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="14" FlowDirection="RightToLeft"><Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <StackPanel><TextBlock x:Name="BankListTitle" Text="بافت‌های بانک" FontSize="17" FontWeight="SemiBold"/><TextBlock x:Name="BankStatus" Foreground="{DynamicResource Muted}" Margin="0,5,0,10" TextWrapping="Wrap"/></StackPanel>
                    <ListBox x:Name="BankList" Grid.Row="1" Background="{DynamicResource ListBackground}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" SelectionChanged="BankSelection_Changed"><ListBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal" Margin="4"><Border Width="62" Height="62" Background="White" BorderBrush="#88949C" BorderThickness="1"><Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/></Border><StackPanel Margin="10,0" VerticalAlignment="Center"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" MaxWidth="175"/><TextBlock Text="{Binding Dimensions}" Foreground="{DynamicResource Muted}" FlowDirection="LeftToRight"/></StackPanel></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
                    <StackPanel Grid.Row="2" Margin="0,12,0,0"><Button x:Name="BankUseButton" Content="اختصاص به رنگ" Click="BankUse_Click" IsEnabled="False" Margin="0,0,0,6"/><Button x:Name="BankEditButton" Content="ویرایش انتخاب‌شده" Click="BankEdit_Click" IsEnabled="False" Margin="0,0,0,6"/><Button x:Name="BankImportButton" Content="افزودن از فایل BMP/TIFF" Click="BankImport_Click" Margin="0,0,0,6"/><Button x:Name="BankDeleteButton" Content="حذف از بانک" Click="BankDelete_Click" IsEnabled="False"/></StackPanel>
                </Grid></Border>
            </Grid>
        </Grid>
        <Border Grid.Row="3" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,1,0,0"><Grid Margin="24,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock x:Name="StatusText" Text="آماده برای باز کردن تصویر" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="12" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="StatsText" Grid.Column="1" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="8,0"/><TextBlock x:Name="DeveloperText" Grid.Column="2" Text="برنامه‌نویس: میرخلیلی" VerticalAlignment="Center" Foreground="{DynamicResource Muted}" FontSize="11" Margin="16,0"/><TextBlock x:Name="VersionText" Grid.Column="3" FlowDirection="LeftToRight" VerticalAlignment="Center" Foreground="#73879B" FontSize="11"/></Grid></Border>
    </Grid>
</Window>
