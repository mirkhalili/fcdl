<Window FontFamily="{StaticResource VazirFont}" x:Class="JacquardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:JacquardStudio"
        Title="Jacquard Studio" Width="1320" Height="820" MinWidth="920" MinHeight="650"
        WindowStartupLocation="CenterScreen" Background="{DynamicResource AppBackground}" FontSize="14" Icon="Assets/app.ico"
        WindowStyle="None" ResizeMode="CanResize" FlowDirection="RightToLeft" PreviewKeyDown="Window_KeyDown" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver" Closing="Window_Closing">
    <WindowChrome.WindowChrome><WindowChrome CaptionHeight="0" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="36"/><RowDefinition Height="70"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1" FlowDirection="LeftToRight" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown" MouseRightButtonUp="TitleBar_MouseRightButtonUp">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Grid.Column="1" Orientation="Horizontal" WindowChrome.IsHitTestVisibleInChrome="True">
                    <Button x:Name="MinimizeWindowButton" Content="−" ToolTip="کمینه کردن" AutomationProperties.Name="Minimize" Click="MinimizeWindow_Click" Width="44" Height="32" Padding="0"/>
                    <Button x:Name="MaximizeWindowButton" Content="□" ToolTip="بزرگ‌نمایی / بازگردانی" AutomationProperties.Name="Maximize or restore" Click="MaximizeWindow_Click" Width="44" Height="32" Padding="0"/>
                    <Button x:Name="CloseWindowButton" Content="✕" ToolTip="بستن" AutomationProperties.Name="Close" Click="CloseWindow_Click" Width="44" Height="32" Background="#71343D" Padding="0"/>
                </StackPanel>
                <TextBlock x:Name="WindowTitleText" Grid.Column="0" Text="{Binding Title, RelativeSource={RelativeSource AncestorType=Window}}" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" FlowDirection="LeftToRight"/>
            </Grid>
        </Border>
        <Border Grid.Row="1" Background="{DynamicResource HeaderBackground}" BorderBrush="{DynamicResource Border}" BorderThickness="0,0,0,1">
            <StackPanel Orientation="Horizontal" FlowDirection="RightToLeft" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="20,0">
                <Button x:Name="ModuleApplyButton" Content="اعمال تنظیمات و بستن" Click="ModuleApply_Click" Visibility="Collapsed" Height="42" Padding="10,4" Margin="3" Background="{DynamicResource ActionBackground}" Foreground="{DynamicResource PrimaryText}"/>
                <Button x:Name="ModuleCancelButton" Content="انصراف" Click="ModuleCancel_Click" Visibility="Collapsed" Height="42" Padding="10,4" Margin="3"/>
                <Button x:Name="LanguageButton" Content="EN" ToolTip="تغییر زبان" AutomationProperties.Name="Change language" Click="Language_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="ThemeButton" Content="☼" ToolTip="تغییر تم" AutomationProperties.Name="Change theme" Click="Theme_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="SaveProjectButton" Content="&#xE74E;" FontFamily="Segoe MDL2 Assets" ToolTip="ذخیره پروژه" AutomationProperties.Name="Save project" Click="SaveProject_Click" Width="48" Height="42" Padding="4" Margin="3" IsEnabled="False"/>
                <Button x:Name="SaveProjectAsButton" Content="&#xE792;" FontFamily="Segoe MDL2 Assets" ToolTip="ذخیره با نام دیگر" AutomationProperties.Name="Save project as" Click="SaveProjectAs_Click" Width="48" Height="42" Padding="4" Margin="3" IsEnabled="False"/>
                <Button x:Name="UndoButton" Content="↶" ToolTip="بازگشت (Ctrl+Z)" AutomationProperties.Name="Undo" Click="Undo_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="20"/>
                <Button x:Name="RedoButton" Content="↷" ToolTip="بازانجام (Ctrl+Y)" AutomationProperties.Name="Redo" Click="Redo_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="20"/>
                <Button x:Name="InfoButton" Content="اطلاعات طرح" ToolTip="طراح، کاربرد و توضیحات" AutomationProperties.Name="Design information" Click="Info_Click" Height="42" Padding="10,4" Margin="3"/>
                <Button x:Name="ReportButton" Content="&#xE749;" FontFamily="Segoe MDL2 Assets" ToolTip="گزارش PDF و چاپ" AutomationProperties.Name="PDF report and printing" Click="Report_Click" Width="48" Height="42" Padding="4" Margin="3"/>
                <Button x:Name="BankButton" Content="▦" ToolTip="بانک و طراحی بافت" AutomationProperties.Name="Weave bank" Click="Bank_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="24"/>
                <Button x:Name="HelpButton" Content="?" ToolTip="راهنمای برنامه (F1)" AutomationProperties.Name="Help" Click="Help_Click" Width="48" Height="42" Padding="4" Margin="3" FontSize="20"/>
                <Button x:Name="AboutButton" Content="&#xE946;" FontFamily="Segoe MDL2 Assets" ToolTip="درباره" AutomationProperties.Name="About" Click="About_Click" Width="48" Height="42" Padding="4" Margin="3"/>
            </StackPanel>
        </Border>
        <Grid x:Name="WorkflowRoot" Grid.Row="2" Margin="22">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid x:Name="Navigation" Margin="0,0,0,16" FlowDirection="RightToLeft">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Button x:Name="OpenButton" Grid.Column="0" ToolTip="بازکردن پروژه یا فایل" AutomationProperties.Name="بازکردن پروژه یا فایل" Click="OpenNavigation_Click" Margin="0,0,6,0" Padding="5,8"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M3,6 L9,6 11,8 21,8 19,19 3,19 Z M3,6 L3,18 M4,10 L21,10" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="SizeStepButton" Grid.Column="1" ToolTip="تنظیم اندازه" AutomationProperties.Name="تنظیم اندازه" Click="SizeStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4,10 L4,4 10,4 M14,4 L20,4 20,10 M20,14 L20,20 14,20 M10,20 L4,20 4,14 M8,16 L16,8 M12,8 L16,8 16,12" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="ColorStepButton" Grid.Column="2" ToolTip="مدیریت رنگ" AutomationProperties.Name="مدیریت رنگ" Click="ColorStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M12,3 C7,3 3,7 3,12 C3,17 7,21 12,21 C14,21 15,20 14,18 C13,16 14,15 17,15 C20,15 21,13 21,11 C21,7 17,3 12,3 Z M7,9 L7.1,9 M11,6.5 L11.1,6.5 M16,8 L16.1,8" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="PatternStepButton" Grid.Column="3" ToolTip="بافت‌ریزی" AutomationProperties.Name="بافت‌ریزی" Click="PatternStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4,4 L20,4 20,20 4,20 Z M9,4 L9,20 M15,4 L15,20 M4,9 L20,9 M4,15 L20,15 M4,4 L9,9 M15,9 L20,4 M9,15 L15,9 M4,15 L9,20 M15,20 L20,15" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="SelvedgeStepButton" Grid.Column="4" ToolTip="تعریف کناره" AutomationProperties.Name="تعریف کناره" Click="SelvedgeStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M3,5 L21,5 21,19 3,19 Z M7,5 L7,19 M17,5 L17,19 M3,10 L7,10 M3,14 L7,14 M17,10 L21,10 M17,14 L21,14 M10,8 L14,8 M10,12 L14,12 M10,16 L14,16" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="WeftStepButton" Grid.Column="7" ToolTip="تعریف پودگذاری" AutomationProperties.Name="تعریف پودگذاری" Click="WeftStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M3,6 L21,6 M3,12 L21,12 M3,18 L21,18 M6,4 L6,8 M11,10 L11,14 M17,16 L17,20 M6,4 L8,4 8,8 6,8 Z M11,10 L13,10 13,14 11,14 Z M17,16 L19,16 19,20 17,20 Z" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="FloatStepButton" Grid.Column="5" ToolTip="فلوت‌گیری" AutomationProperties.Name="فلوت‌گیری" Click="FloatStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4,5 L20,5 M4,10 L20,10 M4,15 L20,15 M4,20 L20,20 M6,3 L6,8 M10,8 L10,13 M14,13 L14,18 M18,3 L18,18 M18,18 L15.5,15.5 M18,18 L20.5,15.5" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="AnalysisStepButton" Grid.Column="6" ToolTip="تحلیل" AutomationProperties.Name="تحلیل" Click="AnalysisStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4,20 L4,4 M4,20 L21,20 M7,16 L10,12 13,14 17,7 20,9 M7,16 L7.1,16 M10,12 L10.1,12 M13,14 L13.1,14 M17,7 L17.1,7" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
                <Button x:Name="SimulationStepButton" Grid.Column="8" ToolTip="شبیه‌سازی پارچه" AutomationProperties.Name="شبیه‌سازی پارچه" Click="SimulationStep_Click" Margin="0,0,6,0" Padding="5,8" IsEnabled="False"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M3,5 L21,5 21,19 3,19 Z M3,9 L21,9 M3,15 L21,15 M7,5 L7,19 M13,5 L13,19 M18,5 L18,19 M4,7 L6,7 M8,12 L12,12 M14,17 L17,17" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6"/></Canvas></Viewbox></Button>
                <Button x:Name="MachineStepButton" Grid.Column="9" ToolTip="خروجی ماشین" AutomationProperties.Name="خروجی ماشین" Click="MachineStep_Click" Margin="0,0,6,0" Padding="5,8"><Viewbox Width="24" Height="24"><Canvas Width="24" Height="24"><Path Data="M4,7 L20,7 20,20 4,20 Z M7,7 L7,4 17,4 17,7 M7,11 L17,11 M7,15 L17,15 M8,20 L8,22 M16,20 L16,22 M10,11 L10,15 M14,11 L14,15" Stroke="{DynamicResource PrimaryText}" StrokeThickness="1.6" StrokeLineJoin="Round" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/></Canvas></Viewbox></Button>
            </Grid>
            <!-- Physical right: settings; left: preview. -->
            <Grid Grid.Row="1" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*" MinWidth="260"/><ColumnDefinition Width="10"/><ColumnDefinition Width="355" MinWidth="270"/></Grid.ColumnDefinitions>
                <GridSplitter Grid.Column="1" Width="10" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="{DynamicResource Border}" ShowsPreview="True" ResizeDirection="Columns" ResizeBehavior="PreviousAndNext" ToolTip="Resize panels"/>
                <Border Grid.Column="2" x:Name="SettingsBorder" FlowDirection="RightToLeft" Background="{DynamicResource Surface}" BorderBrush="{DynamicResource Border}" BorderThickness="1" CornerRadius="12" Padding="18">
                    <Grid><Grid x:Name="RegularSettings"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                        <StackPanel><TextBlock x:Name="FileCaption" Text="فایل ورودی" Foreground="{DynamicResource Muted}" FontSize="12"/><TextBlock x:Name="FileValue" Text="—" FlowDirection="LeftToRight" TextTrimming="CharacterEllipsis" Margin="0,6,0,6"/><StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,0,0,12"><Button x:Name="PreviousPage" Content="‹" Click="PreviousPage_Click" Width="36" Padding="6" IsEnabled="False"/><TextBlock x:Name="PageValue" Text="—" Width="78" TextAlignment="Center" VerticalAlignment="Center"/><Button x:Name="NextPage" Content="›" Click="NextPage_Click" Width="36" Padding="6" IsEnabled="False"/><TextBlock x:Name="FormatValue" Text="" Foreground="{DynamicResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel><Border Height="1" Background="{DynamicResource Border}"/></StackPanel>
                        <Grid Grid.Row="1" Margin="0,16,0,0">
                            <StackPanel x:Name="NoFilePanel"><TextBlock x:Name="NoFileTitle" Text="شروع کار" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="NoFileHint" Text="ابتدا یک تصویر BMP یا TIFF باز کنید یا در پنجره رها کنید." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,10,0,0"/></StackPanel>
                            <StackPanel x:Name="SizePanel" Visibility="Collapsed">
                                <TextBlock x:Name="SizeTitle" Text="مرحله ۱ · تغییر اندازه" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="SizeHint" Text="ابعاد خروجی را وارد و اعمال کنید. تصویر سمت چپ نتیجه همین مرحله است." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,18"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><StackPanel><TextBlock x:Name="WidthLabel" Text="عرض (پیکسل)"/><TextBox x:Name="WidthInput" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,5,0" Padding="7"/></StackPanel><StackPanel Grid.Column="1"><TextBlock x:Name="HeightLabel" Text="ارتفاع (پیکسل)"/><TextBox x:Name="HeightInput" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,0,0" Padding="7"/></StackPanel></Grid>
                                <Button x:Name="ApplySizeButton" Content="اعمال اندازه" Click="ApplySize_Click" Margin="0,16,0,0"/>
                                <Button x:Name="SaveSizeButton" Content="ذخیره خروجی اندازه" Click="Save_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <Button x:Name="ToColorButton" Content="مرحله بعد: رنگ ←" Click="ColorStep_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <TextBlock x:Name="SizeNotice" Text="روش تغییر اندازه نزدیک‌ترین همسایه است؛ نسبت تصویر خودکار حفظ نمی‌شود." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,18,0,0" FontSize="12"/>
                            </StackPanel>
                            <ScrollViewer x:Name="ColorScroll" Visibility="Collapsed" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><StackPanel x:Name="ColorPanel" Visibility="Collapsed">
                                <TextBlock x:Name="ColorTitle" Text="مرحله ۲ · کاهش رنگ" FontSize="18" FontWeight="SemiBold"/>
                                <TextBlock x:Name="ColorHint" Text="ورودی این مرحله تصویر تغییراندازه‌یافته است؛ ابتدا حداکثر ۲۵۶ رنگ سازگار با تصویر نمایش داده می‌شود." TextWrapping="Wrap" Foreground="{DynamicResource Muted}" Margin="0,8,0,16"/>
                                <TextBlock x:Name="ColorLimitLabel" Text="حداکثر تعداد رنگ (۱ تا ۲۵۶)"/><TextBox x:Name="ColorInput" Text="256" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,0,0" Padding="7"/>
                                <TextBlock x:Name="ColorDistanceLabel" Text="آستانه شباهت RGB (۰ تا ۴۴۱؛ صفر = بدون ادغام)" Margin="0,10,0,0" TextWrapping="Wrap"/><TextBox x:Name="ColorDistanceInput" Text="12" TextChanged="Inputs_Changed" FlowDirection="LeftToRight" Margin="0,6,0,0" Padding="7"/>
                                <Button x:Name="ApplyColorButton" Content="اعمال تعداد رنگ" Click="ApplyColor_Click" Margin="0,14,0,0"/>
                                <TextBlock x:Name="ColorSummary" Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,8"/>
                                <ListView x:Name="ColorPaletteList" Height="175" Background="{DynamicResource HeaderBackground}" BorderThickness="0" SelectionMode="Multiple" SelectionChanged="ColorSelection_Changed" GridViewColumnHeader.Click="ColorHeader_Click" FlowDirection="RightToLeft" ScrollViewer.HorizontalScrollBarVisibility="Auto">
                                    <ListView.View><GridView>
                                        <GridViewColumn x:Name="ColorNumberColumn" Header="شماره" Width="55" DisplayMemberBinding="{Binding ColorNumber}"/>
                                        <GridViewColumn x:Name="ColorLockColumn" Header="قفل" Width="55"><GridViewColumn.CellTemplate><DataTemplate><Button Content="{Binding LockIcon}" ToolTip="قفل / باز کردن رنگ" Click="ColorLock_Click" Padding="5,2" Margin="1"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                        <GridViewColumn x:Name="ColorShowColumn" Header="نمایش" Width="58"><GridViewColumn.CellTemplate><DataTemplate><Button Content="{Binding HighlightIcon}" ToolTip="نمایش این رنگ در تصویر" Click="HighlightColor_Click" Padding="6,2" Margin="1"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                        <GridViewColumn x:Name="ColorSwatchColumn" Header="رنگ" Width="55"><GridViewColumn.CellTemplate><DataTemplate><Button Background="{Binding Brush}" ToolTip="تغییر این رنگ" Click="PaletteColor_Click" Width="32" Height="32" Padding="0"/></DataTemplate></GridViewColumn.CellTemplate></GridViewColumn>
                                        <GridViewColumn x:Name="ColorCountColumn" Header="پیکسل" Width="75" DisplayMemberBinding="{Binding PixelCountText}"/>
                                        <GridViewColumn x:Name="ColorPercentColumn" Header="درصد" Width="55" DisplayMemberBinding="{Binding PercentText}"/>
                                    </GridView></ListView.View>
                                </ListView>
                                <TextBlock x:Name="ColorSelectionHint" Text="برای ادغام، دو رنگ را انتخاب کنید." Margin="0,10,0,0" TextWrapping="Wrap" Foreground="{DynamicResource Muted}"/>
                                <Grid Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <Button x:Name="DeleteColorButton" Content="حذف رنگ انتخابی" Click="DeleteColor_Click" IsEnabled="False" Margin="0,0,4,0" Padding="6,8"/>
                                    <Button x:Name="MergeColorButton" Grid.Column="1" Content="ادغام با مقصد" Click="MergeColor_Click" IsEnabled="False" Padding="6,8"/>
                                </Grid>
                                <Button x:Name="SaveColorButton" Content="ذخیره خروجی رنگ" Click="Save_Click" Margin="0,10,0,0" IsEnabled="False"/>
                                <Button x:Name="SavePaletteButton" Content="ذخیره پالت رنگ PNG" Click="SavePalette_Click" Margin="0,8,0,0" IsEnabled="False"/>
                                <Button x:Name="ToPatternButton" Content="مرحله بعد: بافت ←" Click="PatternStep_Click" Margin="0,14,0,0" IsEnabled="False"/>
                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="AnalysisPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock x:Name="AnalysisTitle" Text="تحلیل تارها" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="AnalysisHint" Text="درصدها شاخص نسبی‌اند، نه اندازه‌گیری فیزیکی." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                <Button x:Name="RunAnalysisButton" Content="محاسبه تحلیل" Click="RunAnalysis_Click"/><TextBlock x:Name="AnalysisResultText" Text="برای محاسبه، دکمه بالا را بزنید." Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,8"/>
                                <TextBlock x:Name="AnalysisLegendTitle" Text="راهنمای رنگ‌ها" FontWeight="SemiBold" Margin="0,8,0,4"/><Border Height="18" CornerRadius="3" FlowDirection="LeftToRight"><Border.Background><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#4646F0" Offset="0"/><GradientStop Color="#F0F0F0" Offset="0.5"/><GradientStop Color="#F04646" Offset="1"/></LinearGradientBrush></Border.Background></Border><Grid FlowDirection="LeftToRight" Margin="0,4,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><TextBlock x:Name="LegendLoose" Text="شل‌شدگی" FontSize="11"/><TextBlock x:Name="LegendNeutral" Grid.Column="1" Text="متعادل" FontSize="11" TextAlignment="Center"/><TextBlock x:Name="LegendTight" Grid.Column="2" Text="کشیدگی" FontSize="11" TextAlignment="Right"/></Grid><StackPanel Orientation="Horizontal" Margin="0,5,0,0"><Border Width="16" Height="12" Background="#787878" Margin="0,0,5,0"/><TextBlock x:Name="LegendExcluded" Text="خارج از بافت" FontSize="11"/></StackPanel><TextBlock x:Name="AnalysisRangeText" TextWrapping="Wrap" Margin="0,12,0,0"/><TextBlock x:Name="AnalysisHoverText" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,10,0,0"/>

                            </StackPanel></ScrollViewer>
                            <ScrollViewer x:Name="FloatPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"><StackPanel>
                                <TextBlock x:Name="FloatTitle" Text="بررسی فلوت" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="FloatHint" Text="طول حداقل و جهت را انتخاب کنید؛ همه دنباله‌های سیاه یا سفیدِ پیوسته در خط انتخابی شمرده می‌شوند. روی تصویر کلیک کنید تا نقطه عوض شود." Foreground="{DynamicResource Muted}" TextWrapping="Wrap" Margin="0,10,0,12"/>
                                <TextBlock x:Name="FloatLengthLabel" Text="حداقل طول فلوت"/><TextBox x:Name="FloatMinimum" Text="10" TextChanged="FloatParameters_Changed" FlowDirection="LeftToRight" Padding="7" Margin="0,5,0,8"/>
                                <RadioButton x:Name="FloatWarp" Content="تار (ستون)" GroupName="FloatDirection" Checked="FloatDirection_Changed" IsChecked="True" Margin="0,3"/><RadioButton x:Name="FloatWeft" Content="پود (ردیف)" GroupName="FloatDirection" Checked="FloatDirection_Changed" Margin="0,3"/>
                                <Button x:Name="FloatScanButton" Content="بررسی فلوت‌ها" Click="FloatScan_Click" Margin="0,10,0,0"/><Button x:Name="FloatAutoButton" Content="اصلاح خودکار مرکز فلوت‌ها" Click="FloatAuto_Click" Margin="0,8,0,0"/><TextBlock x:Name="FloatAutoResult" TextWrapping="Wrap" Foreground="{DynamicResource Accent}" Margin="0,6,0,0"/><TextBlock x:Name="FloatResultText" Text="هنوز بررسی نشده است." Foreground="{DynamicResource Accent}" TextWrapping="Wrap" Margin="0,14,0,8"/>
