<Window FontFamily="{StaticResource VazirFont}" x:Class="JacquardStudio.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Jacquard Studio" Width="1320" Height="820" MinWidth="900" MinHeight="620"
        WindowStartupLocation="CenterScreen" Background="#0C1420" FontSize="14" Icon="Assets/app.ico"
        FlowDirection="RightToLeft" AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <Grid>
        <Grid.RowDefinitions><RowDefinition Height="72"/><RowDefinition Height="*"/><RowDefinition Height="38"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#111B29" BorderBrush="#27384B" BorderThickness="0,0,0,1">
            <Grid Margin="28,0">
                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="JACQUARD STUDIO" FontSize="16" FontWeight="Bold" FlowDirection="LeftToRight" HorizontalAlignment="Right"/>
                    <TextBlock x:Name="SubtitleText" Text="فضای کار طراحی و بازرسی ژاکارد" Foreground="{StaticResource Muted}" FontSize="11" Margin="0,3,0,0"/>
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Border Background="#1C3A38" CornerRadius="12" Padding="10,5" Margin="12,0"><TextBlock x:Name="BadgeText" Text="نسخه آزمایشی" Foreground="#69E4C7" FontSize="11"/></Border>
                    <Button x:Name="AboutButton" Content="درباره" Click="About_Click" Padding="12,7" Margin="0,0,8,0"/>
                    <Button x:Name="LanguageButton" Content="English" Click="Language_Click" Padding="12,7" AutomationProperties.Name="Switch language"/>
                </StackPanel>
            </Grid>
        </Border>
        <Grid Grid.Row="1" Margin="24">
            <Grid.ColumnDefinitions><ColumnDefinition Width="250"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="250"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="WorkspaceTitle" Text="فضای کاری" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="WorkspaceHeading" Text="شروع پروژه" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,18"/>
                    <Button x:Name="OpenButton" Content="+  باز کردن تصویر" Click="Open_Click" Background="#36C9AB" BorderBrush="#36C9AB" Foreground="#082621" FontWeight="Bold"/>
                    <Button x:Name="PrepareButton" Content="ابعاد، رنگ و پترن  ←" Click="Prepare_Click" IsEnabled="False" Margin="0,10,0,0"/>
                    <TextBlock x:Name="OpenHint" Text="یا فایل BMP / TIFF را اینجا رها کنید" TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,12,0,24"/>
                    <Border Background="#202D3C" Height="1"/>
                    <TextBlock x:Name="WorkflowTitle" Text="مراحل کار" FontWeight="SemiBold" Margin="0,22,0,14"/>
                    <TextBlock x:Name="StepOne" Text="۱   باز کردن و پیش‌نمایش" Foreground="#65E0C6" Margin="0,0,0,18"/>
                    <TextBlock x:Name="StepTwo" Text="۲   تنظیمات و پروفایل ماشین" Foreground="#73879B" Margin="0,0,0,18"/>
                    <TextBlock x:Name="StepThree" Text="۳   تبدیل و بررسی خروجی" Foreground="#73879B"/>
                </StackPanel>
            </Border>
            <Grid Grid.Column="2">
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <StackPanel><TextBlock x:Name="CanvasTitle" Text="پیش‌نمایش طرح" FontSize="22" FontWeight="SemiBold"/><TextBlock x:Name="CanvasSubtitle" Text="بررسی دقیق تصویر پیش از آماده‌سازی" Foreground="{StaticResource Muted}" FontSize="12" Margin="0,4,0,0"/></StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                        <Button x:Name="ZoomOutButton" Content="−" Click="ZoomOut_Click" Width="40" Padding="6" Margin="0,0,5,0" ToolTip="Zoom out"/>
                        <TextBlock x:Name="ZoomText" Text="100%" Width="55" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="ZoomInButton" Content="+" Click="ZoomIn_Click" Width="40" Padding="6" Margin="5,0" ToolTip="Zoom in"/>
                        <Button x:Name="ZoomResetButton" Content="100%" Click="ZoomReset_Click" Padding="10,6"/>
                    </StackPanel>
                </Grid>
                <Border Grid.Row="1" Background="#0B121D" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                    <Grid>
                        <ScrollViewer x:Name="ImageScroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto" FlowDirection="LeftToRight" Visibility="Collapsed">
                            <Image x:Name="PreviewImage" HorizontalAlignment="Left" VerticalAlignment="Top" Stretch="None" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                        </ScrollViewer>
                        <StackPanel x:Name="EmptyState" HorizontalAlignment="Center" VerticalAlignment="Center" Width="350">
                            <Border Width="72" Height="72" Background="#172A36" BorderBrush="#2E5C5C" BorderThickness="1" CornerRadius="22"><TextBlock Text="▦" Foreground="#59DBBF" FontSize="40" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                            <TextBlock x:Name="EmptyTitle" Text="طرح خود را وارد کنید" FontSize="20" FontWeight="SemiBold" TextAlignment="Center" Margin="0,22,0,8"/>
                            <TextBlock x:Name="EmptyHint" Text="یک تصویر BMP یا TIFF انتخاب کنید تا آن را با جزئیات بررسی کنید." TextWrapping="Wrap" TextAlignment="Center" Foreground="{StaticResource Muted}" LineHeight="22"/>
                            <Button x:Name="EmptyButton" Content="انتخاب تصویر" Click="Open_Click" HorizontalAlignment="Center" Margin="0,20,0,0"/>
                        </StackPanel>
                    </Grid>
                </Border>
                <Border Grid.Row="2" Background="#1B302D" CornerRadius="8" Padding="14,10" Margin="0,14,0,0">
                    <TextBlock x:Name="SafetyText" Text="تبدیل به فایل ماشین هنوز فعال نیست. از این نسخه برای تولید استفاده نکنید." Foreground="#B4E5D7" TextWrapping="Wrap" FontSize="12"/>
                </Border>
            </Grid>
            <Border Grid.Column="4" Background="{StaticResource Surface}" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="12" Padding="20">
                <StackPanel>
                    <TextBlock x:Name="InfoCaption" Text="جزئیات فایل" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="InfoTitle" Text="اطلاعات تصویر" FontSize="20" FontWeight="SemiBold" Margin="0,8,0,20"/>
                    <TextBlock x:Name="FileLabel" Text="نام فایل" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="FileValue" Text="—" TextWrapping="Wrap" FlowDirection="LeftToRight" Margin="0,6,0,18"/>
                    <TextBlock x:Name="DimensionsLabel" Text="ابعاد" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="DimensionsValue" Text="—" FlowDirection="LeftToRight" Margin="0,6,0,18"/>
                    <TextBlock x:Name="FormatLabel" Text="نوع تصویر" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <TextBlock x:Name="FormatValue" Text="—" FlowDirection="LeftToRight" Margin="0,6,0,18"/>
                    <TextBlock x:Name="PageLabel" Text="صفحه تصویر" Foreground="{StaticResource Muted}" FontSize="12"/>
                    <StackPanel Orientation="Horizontal" FlowDirection="LeftToRight" Margin="0,8,0,18">
                        <Button x:Name="PreviousPage" Content="‹" Width="40" Padding="6" Click="PreviousPage_Click" IsEnabled="False"/>
                        <TextBlock x:Name="PageValue" Text="—" Width="70" TextAlignment="Center" VerticalAlignment="Center"/>
                        <Button x:Name="NextPage" Content="›" Width="40" Padding="6" Click="NextPage_Click" IsEnabled="False"/>
                    </StackPanel>
                    <Border Background="#202D3C" Height="1"/>
                    <TextBlock x:Name="NoticeTitle" Text="وضعیت پشتیبانی" FontWeight="SemiBold" Margin="0,20,0,8"/>
                    <TextBlock x:Name="NoticeText" Text="خواندن و نوشتن فایل دستگاه در این مرحله پیاده‌سازی نشده است." TextWrapping="Wrap" Foreground="{StaticResource Muted}" FontSize="12" LineHeight="20"/>
                </StackPanel>
            </Border>
        </Grid>
        <Border Grid.Row="2" Background="#111B29" BorderBrush="#27384B" BorderThickness="0,1,0,0">
            <Grid Margin="28,0"><TextBlock x:Name="StatusText" Text="آماده برای باز کردن تصویر" VerticalAlignment="Center" Foreground="{StaticResource Muted}" FontSize="12"/><TextBlock Text="002.1.1.0-a1" FlowDirection="LeftToRight" HorizontalAlignment="Left" VerticalAlignment="Center" Foreground="#73879B" FontSize="11"/></Grid>
        </Border>
    </Grid>
</Window>
