<Application x:Class="JacquardStudio.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ui:ThemesDictionary Theme="Light" />
                <ui:ControlsDictionary />
            </ResourceDictionary.MergedDictionaries>
        <!-- Jacquard Vazir design system: light surfaces, RTL layout, and the reference cobalt accent. -->
        <SolidColorBrush x:Key="AppBackground" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="HeaderBackground" Color="#FBFCFE"/>
        <SolidColorBrush x:Key="CanvasBackground" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="PrimaryText" Color="#181F2B"/>
        <SolidColorBrush x:Key="ButtonBackground" Color="#F1F4F8"/>
        <SolidColorBrush x:Key="ButtonBorder" Color="#D8E0EA"/>
        <SolidColorBrush x:Key="GalleryBackground" Color="#F1F5FA"/>
        <SolidColorBrush x:Key="ListBackground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Surface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="Border" Color="#E1E5EC"/>
        <SolidColorBrush x:Key="Muted" Color="#707887"/>
        <SolidColorBrush x:Key="Accent" Color="#2C60F6"/>
        <SolidColorBrush x:Key="IconGlyph" Color="#2C60F6"/>
        <SolidColorBrush x:Key="AccentForeground" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="SelectionFill" Color="#332C60F6"/>
        <SolidColorBrush x:Key="ActionBackground" Color="#2C60F6"/>
        <SolidColorBrush x:Key="DangerBackground" Color="#FCEBED"/>
        <SolidColorBrush x:Key="GraphBackground" Color="#F8FAFD"/>
        <SolidColorBrush x:Key="GraphGrid" Color="#E5EBF3"/>
        <SolidColorBrush x:Key="GraphHeader" Color="#FBFCFE"/>
        <SolidColorBrush x:Key="GraphSurface" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GraphNode" Color="#FFFFFF"/>
        <SolidColorBrush x:Key="GraphNodeHeader" Color="#F2F5FA"/>
        <SolidColorBrush x:Key="GraphPreview" Color="#F4F6FA"/>
        <SolidColorBrush x:Key="GraphSelection" Color="#2C60F6"/>
        <SolidColorBrush x:Key="GraphSelectedItem" Color="#EDF2FF"/>

        <ItemsPanelTemplate x:Key="WeaveGalleryPanel"><WrapPanel IsItemsHost="True"/></ItemsPanelTemplate>
        <DataTemplate x:Key="WeaveGalleryItem">
            <StackPanel Width="86" Margin="2" ToolTip="{Binding Name}">
                <Border Width="62" Height="62" Padding="3" Background="White" BorderBrush="#89949B" BorderThickness="1" CornerRadius="3">
                    <Image Source="{Binding Preview}" Stretch="Uniform" RenderOptions.BitmapScalingMode="NearestNeighbor"/>
                </Border>
                <TextBlock Text="{Binding Name}" TextAlignment="Center" TextTrimming="CharacterEllipsis" FontSize="11" Margin="0,4,0,0"/>
                <TextBlock Text="{Binding Dimensions}" TextAlignment="Center" FlowDirection="LeftToRight" FontSize="10" Foreground="{DynamicResource Muted}"/>
            </StackPanel>
        </DataTemplate>
        <Style x:Key="WeaveGalleryListItem" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="2"/>
            <Setter Property="Margin" Value="2"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border x:Name="Tile" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="4" Padding="{TemplateBinding Padding}">
                            <ContentPresenter/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Tile" Property="Background" Value="{DynamicResource ButtonBackground}"/></Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Tile" Property="Background" Value="{DynamicResource GraphSelectedItem}"/>
                                <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource GraphSelection}"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <FontFamily x:Key="VazirFont">pack://application:,,,/JacquardStudio;component/Assets/Fonts/#Vazirmatn</FontFamily>
        <Style TargetType="ui:FluentWindow" BasedOn="{StaticResource DefaultFluentWindowStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="Window" BasedOn="{StaticResource DefaultWindowStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource AppBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="TextBox" BasedOn="{StaticResource DefaultTextBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="SelectionBrush" Value="{DynamicResource Accent}"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="PasswordBox" BasedOn="{StaticResource DefaultPasswordBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="CaretBrush" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="MinHeight" Value="30"/>
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource DefaultCheckBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="RadioButton" BasedOn="{StaticResource DefaultRadioButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="Expander" BasedOn="{StaticResource DefaultExpanderStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
        </Style>
        <Style TargetType="ToolTip" BasedOn="{StaticResource DefaultToolTipStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style TargetType="ContextMenu" BasedOn="{StaticResource UiContextMenu}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Background" Value="{DynamicResource Surface}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style TargetType="MenuItem" BasedOn="{StaticResource UiMenuItem}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ListBox" BasedOn="{StaticResource DefaultListBoxStyle}">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style TargetType="ListView">
            <Setter Property="Background" Value="{DynamicResource ListBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
        </Style>
        <Style TargetType="ListBoxItem" BasedOn="{StaticResource DefaultListBoxItemStyle}">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="6,4"/>
        </Style>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Background" Value="{DynamicResource HeaderBackground}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource Border}"/>
            <Setter Property="Padding" Value="5,4"/>
        </Style>
        <Style TargetType="ComboBoxItem" BasedOn="{StaticResource DefaultComboBoxItemStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="ComboBox" BasedOn="{StaticResource DefaultComboBoxStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        <Style TargetType="ToggleButton" BasedOn="{StaticResource DefaultToggleButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Padding" Value="8,5"/>
        </Style>
        <Style TargetType="Button" BasedOn="{StaticResource DefaultButtonStyle}">
            <Setter Property="FontFamily" Value="{StaticResource VazirFont}"/>
            <Setter Property="Foreground" Value="{DynamicResource PrimaryText}"/>
            <Setter Property="Background" Value="{DynamicResource ButtonBackground}"/>
            <Setter Property="BorderBrush" Value="{DynamicResource ButtonBorder}"/>
            <Setter Property="Padding" Value="14,8"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="FontSize" Value="13"/>
            <Setter Property="MinHeight" Value="32"/>
        </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
