<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>JacquardStudio</AssemblyName>
    <Version>43.0.0.0</Version>
    <AssemblyVersion>43.0.0.0</AssemblyVersion>
    <FileVersion>43.0.0.0</FileVersion>
    <InformationalVersion>$([System.IO.File]::ReadAllText('$(MSBuildProjectDirectory)/../../version.txt').Trim())</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <Product>Jacquard Studio</Product>
    <ApplicationIcon>Assets/app.ico</ApplicationIcon>
    <!-- Public verification key only; the private signing key must never be included. -->
    <LicensePublicKeyFile Condition="'$(LicensePublicKeyFile)' == ''">$(MSBuildProjectDirectory)/../../Docs/private-key.public.pem</LicensePublicKeyFile>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="../LicenseCore/LicenseCore.csproj" />
    <PackageReference Include="System.Management" Version="10.0.0" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.0" />
    <PackageReference Include="HelixToolkit.Wpf" Version="3.1.2" />
    <PackageReference Include="bblanchon.PDFium.Win32" Version="151.0.7891" />
    <PackageReference Include="SkiaSharp" Version="3.119.1" />
  </ItemGroup>
  <ItemGroup Condition="'$(LicensePublicKeyFile)' != ''">
    <EmbeddedResource Include="$(LicensePublicKeyFile)" LogicalName="JacquardStudio.LicensePublicKey.pem" />
  </ItemGroup>
  <ItemGroup>
    <Content Include="Assets/SkiaSharp-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/PDFium-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Content Include="Assets/HelixToolkit-LICENSE.txt" CopyToOutputDirectory="PreserveNewest" />
    <Resource Include="Assets/Fonts/*.ttf" />
    <Resource Include="Assets/app.ico" />
    <Resource Include="Assets/sam-emblem.png" />
    <Resource Include="Assets/Brands/*" />
    <Resource Include="Assets/UserIcons/*.jpg" />
    <Resource Include="Help.fa.txt" />
    <Content Include="Assets/Fonts/OFL.txt" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
</Project>
