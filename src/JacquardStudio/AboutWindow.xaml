<Window FontFamily="{StaticResource VazirFont}" x:Class="JacquardStudio.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="درباره برنامه" Width="480" Height="430" ResizeMode="NoResize" WindowStartupLocation="CenterOwner"
        Background="{DynamicResource HeaderBackground}" FlowDirection="RightToLeft" Icon="Assets/app.ico">
    <StackPanel Margin="32">
        <Image Source="Assets/app.ico" Width="64" Height="64" HorizontalAlignment="Center"/>
        <TextBlock Text="JACQUARD STUDIO" FlowDirection="LeftToRight" HorizontalAlignment="Center" FontSize="20" FontWeight="Bold" Margin="0,14,0,0"/>
        <TextBlock x:Name="VersionText" Text="" FlowDirection="LeftToRight" HorizontalAlignment="Center" Foreground="{DynamicResource Accent}" Margin="0,5,0,18"/>
        <TextBlock x:Name="DescriptionText" Text="ابزار آزمایشی ویندوز برای طراحی ژاکارد، ساخت بافت و فایل ماشین در محدوده نمونه‌های بررسی‌شده." TextWrapping="Wrap" TextAlignment="Center" Foreground="{DynamicResource Muted}" LineHeight="24"/>
        <TextBlock x:Name="AuthorText" Text="برنامه‌نویس: میرخلیلی" HorizontalAlignment="Center" Margin="0,20,0,10"/>
        <Button Content="mirkhalili.com ↗" HorizontalAlignment="Center" FlowDirection="LeftToRight" Click="Website_Click"/>
    </StackPanel>
</Window>
